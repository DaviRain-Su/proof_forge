# Local Anvil defaults (pf demo script writes public/deployment.json — preferred).
# Never put mainnet or testnet private keys here.

# Optional overrides if you skip deployment.json:
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CONTRACT_ADDRESS=
VITE_CONSTRUCTOR_INITIAL=7

# Or pick a catalog network id (docs/product/networks.v1.json):
# VITE_NETWORK_ID=evm.local.anvil
# VITE_NETWORK_ID=evm.xlayer.testnet
# VITE_NETWORK_ID=evm.xlayer.mainnet
# When set, fills chainId/rpc if VITE_CHAIN_ID / VITE_RPC_URL are empty.
# X Layer gas token is OKB — fund the wallet before writes.
