{"noir_version":"1.0.0-beta.26+40d6574f851d926f93e0c3a271bac3e6e82ac905","hash":"4152353602006729362","abi":{"parameters":[{"name":"pre_initialized","type":{"kind":"boolean"},"visibility":"public"},{"name":"pre_s0","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"pre_s1","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"post_s0","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"post_s1","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"post_initialized","type":{"kind":"boolean"},"visibility":"public"},{"name":"result","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"52":{"source":"fn main(pre_initialized: pub bool, pre_s0: pub u64, pre_s1: pub u64, post_s0: pub u64, post_s1: pub u64, post_initialized: pub bool, result: pub u64) {\n    assert(pre_initialized == true);\n    if pre_s0 == 1 {\n      assert(post_s0 == pre_s0);\n      assert(post_s1 == pre_s1);\n      assert(post_initialized == true);\n      assert(result == pre_s1);\n    } else {\n      assert(post_s0 == pre_s0);\n      assert(post_s1 == pre_s1);\n      assert(post_initialized == true);\n      assert(result == 0);\n    }\n}\n","path":"src/main.nr","function_locations":[{"start":150,"name":"main"}]}}}
