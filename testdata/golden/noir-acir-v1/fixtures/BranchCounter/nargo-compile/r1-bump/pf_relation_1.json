{"noir_version":"1.0.0-beta.26+40d6574f851d926f93e0c3a271bac3e6e82ac905","hash":"5326684273681879262","abi":{"parameters":[{"name":"pre_initialized","type":{"kind":"boolean"},"visibility":"public"},{"name":"pre_s0","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"arg_p0","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"post_s0","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"post_initialized","type":{"kind":"boolean"},"visibility":"public"},{"name":"result","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"}],"return_type":null,"error_types":{"1998584279744703196":{"error_kind":"string","string":"attempt to subtract with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"52":{"source":"fn main(pre_initialized: pub bool, pre_s0: pub u64, arg_p0: pub u64, post_s0: pub u64, post_initialized: pub bool, result: pub u64) {\n    assert(pre_initialized == true);\n    let t0: bool = pre_s0 >= arg_p0;\n    if t0 {\n      assert(pre_s0 >= arg_p0);\n      let t1: u64 = pre_s0 - arg_p0;\n      assert(post_s0 == t1);\n      assert(post_initialized == true);\n      assert(result == t1);\n    } else {\n      let t2: u64 = pre_s0 + arg_p0;\n      assert(post_s0 == t2);\n      assert(post_initialized == true);\n      assert(result == t2);\n    }\n}\n","path":"src/main.nr","function_locations":[{"start":132,"name":"main"}]}}}
