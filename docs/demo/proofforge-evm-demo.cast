[0.321, "o", "/-\r\nCopyright (c) 2026 DaviRain. All rights reserved.\r\nReleased under Apache 2.0 license as described in the file LICENSE.\r\n\r\nPortable VerifiedVault for the unified EVM entry path. Source-level financial\r\nproofs remain in `VerifiedVault.Spec`; codegen uses portable IR only.\r\n-/\r\nimport ProofForge.Contract.Source.Legacy\r\nimport ProofForge.Contract.Stdlib.ReentrancyGuard\r\n\r\nnamespace VerifiedVault\r\n\r\nopen ProofForge.Contract.Source.Legacy\r\nopen ProofForge.Contract.Stdlib.ReentrancyGuard\r\n\r\nnamespace Spec\r\n"]
[0.000, "o", "\r\nstructure State where\r\n  reserves : Nat\r\n  shares   : Nat\r\n\r\ndef solvent (s : State) : Prop := s.reserves = s.shares\r\n\r\ndef empty : State := { reserves := 0, shares := 0 }\r\n\r\ndef deposit? (s : State) (amount : Nat) : Option State :=\r\n"]
[0.000, "o", "  some { reserves := s.reserves + amount, shares := s.shares + amount }\r\n\r\n"]
[0.000, "o", "def withdraw? (s : State) (amount : Nat) : Option State :=\r\n"]
[0.000, "o", "  if amount ≤ s.reserves ∧ amount ≤ s.shares then\r\n"]
[0.000, "o", "    some { reserves := s.reserves - amount, shares := s.shares - amount }\r\n  else none\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "def canWithdraw (s : State) (amount : Nat) : Bool :=\r\n"]
[0.000, "o", "  amount ≤ s.reserves ∧ amount ≤ s.shares\r\n"]
[0.000, "o", "\r\ntheorem empty_solvent : solvent empty := by rfl\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "theorem deposit_preserves_solvent {s next : State} {amount : Nat}\r\n"]
[0.000, "o", "    (h : solvent s) (hn : deposit? s amount = some next) : solvent next := by\r\n"]
[0.001, "o", "\r\n"]
[1.013, "o", "VerifiedVault demonstrates proof-carrying contract authoring with\r\nassertions, context reads (caller, address, block number), and\r\n"]
[0.000, "o", "compound storage assignment.\r\n\r\n"]
[2.007, "o", "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  Part 2/4: Compilation (Lean → IR → Yul → Bytecode)\r\n"]
[0.000, "o", "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n"]
