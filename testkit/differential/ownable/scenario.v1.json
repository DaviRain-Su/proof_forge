    {"dimension": "resources", "scope": "/steps/zero-address-transfer/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
    {"dimension": "resources", "scope": "/steps/transfer-to-bob/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
    {"dimension": "resources", "scope": "/steps/owner-bob/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
    {"dimension": "resources", "scope": "/steps/old-owner-renounce/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
    {"dimension": "resources", "scope": "/steps/renounce-bob/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
    {"dimension": "resources", "scope": "/steps/owner-zero/observations/resources/metrics/execution/value", "reason": "Target-local execution cost is retained as evidence, not required to be equal across independent implementations."},
